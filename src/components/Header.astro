---
const logoUrl = '/assets/favicon.png';
const instagramUrl = 'https://www.instagram.com/barrioscontadores/';

const navItems = [
  { id: 'inicio', label: 'Inicio' },
  { id: 'quienes-somos-resumen', label: 'Quiénes Somos' },
  { id: 'testimonios', label: 'Testimonios' },
  { id: 'servicios', label: 'Servicios' },
  { id: 'contacto', label: 'Contacto' },
];
---

<!-- Floating Pill Header -->
<header class="fixed top-3 left-0 right-0 z-50 px-4 sm:px-6 pointer-events-none">
  <div class="max-w-7xl mx-auto pointer-events-auto">
    <div class="floating-nav-pill bg-surface-container-lowest/90 backdrop-blur-md border border-outline-variant/40 shadow-lg rounded-full px-2.5 sm:px-5 py-2 flex items-center justify-between gap-1.5 sm:gap-3 transition-all duration-300">
      <!-- Brand Logo + Name -->
      <a
        class="flex items-center gap-2 sm:gap-2.5 group rounded-full focus:outline-none focus:ring-2 focus:ring-primary/40 pr-1 sm:pr-2 py-0.5 transition-all flex-shrink-0"
        href="#inicio"
        data-nav-link="inicio"
      >
        <img
          alt="Barrios Contadores & Asociados"
          class="w-8 h-8 sm:w-10 sm:h-10 object-contain rounded-full transition-transform group-hover:scale-105 duration-200"
          src={logoUrl}
        />
        <div class="flex flex-col">
          <span class="font-headline-large text-[13px] sm:text-base font-bold text-primary tracking-tight leading-tight whitespace-nowrap">
            Barrios Contadores
          </span>
          <span class="hidden sm:block text-[10px] font-semibold text-secondary tracking-wide leading-tight">
            &amp; Asociados • CPA
          </span>
        </div>
      </a>

      <!-- Center Desktop Navigation -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
        {navItems.map((item, idx) => (
          <a
            href={`#${item.id}`}
            data-nav-link={item.id}
            data-desktop-nav
            class:list={[
              'px-3.5 py-1.5 rounded-full text-sm transition-all duration-200 whitespace-nowrap',
              idx === 0
                ? 'bg-primary text-on-primary font-semibold shadow-sm'
                : 'text-on-surface-variant hover:text-primary hover:bg-surface-container font-medium',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right Action Buttons -->
      <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
        <!-- Circular Instagram Icon Button -->
        <a
          aria-label="Instagram"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-outline-variant/50 bg-surface-container-low hover:border-[#E4405F] hover:bg-[#E4405F]/10 text-on-surface-variant hover:text-[#E4405F] transition-all flex items-center justify-center"
          href={instagramUrl}
          rel="noopener noreferrer"
          target="_blank"
          title="Instagram"
        >
          <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3Z" />
          </svg>
        </a>

        <!-- Circular WhatsApp Icon Button -->
        <a
          aria-label="WhatsApp Directo"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-outline-variant/50 bg-surface-container-low hover:border-whatsapp-green hover:bg-whatsapp-green/10 text-on-surface-variant hover:text-whatsapp-green transition-all flex items-center justify-center"
          href="https://wa.me/50762272263?text=Hola,%20deseo%20agendar%20una%20consulta%20contable"
          rel="noopener noreferrer"
          target="_blank"
          title="WhatsApp"
        >
          <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.53c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.22.89 2.41 1.02 2.58.13.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.3" />
          </svg>
        </a>

        <!-- Circular Dark Mode Toggle -->
        <button
          id="theme-toggle-btn"
          aria-label="Alternar modo oscuro"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-outline-variant/50 bg-surface-container-low text-on-surface-variant hover:text-primary hover:border-primary/40 flex items-center justify-center transition-all duration-200"
          type="button"
        >
          <span id="theme-icon-dark" class="material-symbols-outlined text-lg">dark_mode</span>
          <span id="theme-icon-light" class="material-symbols-outlined text-lg text-gold-light hidden">light_mode</span>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          class="lg:hidden w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-outline-variant/50 bg-surface-container-low text-on-surface hover:text-primary flex items-center justify-center transition-colors"
        >
          <span id="mobile-menu-icon" class="material-symbols-outlined text-xl">menu</span>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Floating Card -->
    <div
      id="mobile-menu-dropdown"
      class="hidden lg:hidden mt-2 p-3 rounded-3xl bg-surface-container-lowest/95 backdrop-blur-md border border-outline-variant/40 shadow-xl flex-col gap-1"
    >
      {navItems.map((item, idx) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          data-mobile-nav
          class:list={[
            'px-4 py-2.5 rounded-2xl text-sm transition-colors',
            idx === 0
              ? 'bg-primary text-on-primary font-semibold'
              : 'text-on-surface-variant hover:text-primary hover:bg-surface-container font-medium',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle-btn');
  const iconDark = document.getElementById('theme-icon-dark');
  const iconLight = document.getElementById('theme-icon-light');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuIcon = document.getElementById('mobile-menu-icon');
  const mobileDropdown = document.getElementById('mobile-menu-dropdown');
  const navIds = ['inicio', 'quienes-somos-resumen', 'testimonios', 'servicios', 'contacto'];

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (iconDark && iconLight) {
      iconDark.classList.toggle('hidden', isDark);
      iconLight.classList.toggle('hidden', !isDark);
    }
  }

  function setMobileMenu(open: boolean) {
    if (!mobileDropdown || !mobileMenuBtn || !mobileMenuIcon) return;
    mobileDropdown.classList.toggle('hidden', !open);
    mobileDropdown.classList.toggle('flex', open);
    mobileMenuBtn.setAttribute('aria-expanded', String(open));
    mobileMenuIcon.textContent = open ? 'close' : 'menu';
  }

  function setActiveNav(sectionId: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-desktop-nav]').forEach((el) => {
      const active = el.dataset.navLink === sectionId;
      el.classList.toggle('bg-primary', active);
      el.classList.toggle('text-on-primary', active);
      el.classList.toggle('font-semibold', active);
      el.classList.toggle('shadow-sm', active);
      el.classList.toggle('text-on-surface-variant', !active);
      el.classList.toggle('hover:text-primary', !active);
      el.classList.toggle('hover:bg-surface-container', !active);
      el.classList.toggle('font-medium', !active);
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav]').forEach((el) => {
      const active = el.dataset.navLink === sectionId;
      el.classList.toggle('bg-primary', active);
      el.classList.toggle('text-on-primary', active);
      el.classList.toggle('font-semibold', active);
      el.classList.toggle('text-on-surface-variant', !active);
      el.classList.toggle('hover:text-primary', !active);
      el.classList.toggle('hover:bg-surface-container', !active);
      el.classList.toggle('font-medium', !active);
    });
  }

  function updateActiveSectionOnScroll() {
    if (window.scrollY < 80) {
      setActiveNav('inicio');
      return;
    }

    const reachedBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 80;
    if (reachedBottom) {
      setActiveNav('contacto');
      return;
    }

    const triggerOffset = 160;
    let current = 'inicio';
    for (const id of navIds) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= triggerOffset) {
        current = id;
      }
    }
    setActiveNav(current);
  }

  syncThemeIcons();
  updateActiveSectionOnScroll();

  themeBtn?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {}
    syncThemeIcons();
  });

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
    setMobileMenu(!isOpen);
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.dataset.navLink;
      if (id) setActiveNav(id);
      setMobileMenu(false);
    });
  });

  window.addEventListener('scroll', updateActiveSectionOnScroll, { passive: true });
</script>
