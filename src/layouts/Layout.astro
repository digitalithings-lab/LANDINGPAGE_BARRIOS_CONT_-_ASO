---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Barrios Contadores & Asociados | Contadores Públicos Autorizados en Panamá',
  description = 'Firma contable y consultoría fiscal en Panamá. Contadores Públicos Autorizados (CPA): contabilidad NIIF, declaraciones DGI e ITBMS, planillas CSS/SIPE, aviso de operación y facturación electrónica.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/assets/logo.png', Astro.site).toString();

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'Barrios Contadores & Asociados',
  url: 'https://barrioscontadores.com',
  description:
    'Firma especializada en consultoría contable, cumplimiento fiscal ante la DGI, gestión laboral y auditoría financiera para personas naturales y jurídicas en Panamá.',
  image: ogImageUrl,
  telephone: '+507-6227-2263',
  email: 'barrioscontadores@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ciudad de Panamá',
    addressCountry: 'PA',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Panamá',
  },
  openingHours: 'Mo-Fr 08:00-17:00',
  priceRange: '$$',
  sameAs: ['https://www.instagram.com/barrioscontadores/'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+507-6227-2263',
    contactType: 'customer service',
    availableLanguage: 'Spanish',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Contables y Fiscales',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Servicios Contables bajo NIIF' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Trámites Legales y Aviso de Operación' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Declaraciones Fiscales DGI e ITBMS' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gestión Laboral, Planillas CSS y SIPE' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Facturación Electrónica y Soporte e-Tax 2.0' } },
    ],
  },
};
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="contadores en Panamá, CPA Panamá, asesoría tributaria DGI, declaración de renta Panamá, ITBMS, planillas SIPE CSS, aviso de operación, facturación electrónica PAC, Barrios Contadores"
    />
    <meta name="author" content="Barrios Contadores & Asociados" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#5e1326" />

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Barrios Contadores & Asociados" />
    <meta property="og:title" content="Barrios Contadores & Asociados | Tu aliado contable de confianza en Panamá" />
    <meta
      property="og:description"
      content="Soluciones contables, fiscales y laborales para emprendedores y pymes en Panamá. Cumplimiento oportuno ante la DGI y atención personalizada 1 a 1."
    />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Barrios Contadores & Asociados - Firma Contable en Panamá" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Barrios Contadores & Asociados | Contadores CPA en Panamá" />
    <meta
      name="twitter:description"
      content="Soluciones contables, fiscales y laborales para emprendedores y empresas en Panamá. Cumplimiento DGI, planillas y facturación electrónica."
    />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />

    <!-- Google Fonts: Material Symbols Outlined & Roboto Flex -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (Schema.org AccountingService) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-surface text-on-surface antialiased font-title-medium selection:bg-primary selection:text-on-primary">
    <slot />
  </body>
</html>
