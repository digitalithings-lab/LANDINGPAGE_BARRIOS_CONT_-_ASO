<script src="https://widgets.sociablekit.com/instagram-feed/widget.js" defer></script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('contact-status');
  const statusClose = document.getElementById('contact-status-close');
  const mailtoLink = document.getElementById('contact-mailto-link') as HTMLAnchorElement | null;
  const waLink = document.getElementById('contact-wa-link') as HTMLAnchorElement | null;

  const serviceLabels: Record<string, string> = {
    contabilidad: 'Servicios Contables Generales',
    declaracion: 'Declaraciones de Renta & ITBMS (DGI)',
    tramites: 'Aviso de Operación & Trámites Legales',
    laboral: 'Planillas y Gestión Laboral (SIPE / CSS)',
    digitales: 'Facturación Electrónica & Soporte e-Tax',
    otro: 'Asesoría Integral Personalizada',
  };

  function sanitizeSingleLine(value: string, maxLength: number): string {
    return value
      .replace(/[\r\n\t\x00-\x1F\x7F]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, maxLength);
  }

  function sanitizeMessage(value: string, maxLength: number): string {
    return value
      .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '')
      .trim()
      .slice(0, maxLength);
  }

  statusClose?.addEventListener('click', () => {
    statusBox?.classList.add('hidden');
    statusBox?.classList.remove('flex');
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const website = String(data.get('website') ?? '');
    if (website.trim().length > 0) return;

    const fullName = sanitizeSingleLine(String(data.get('full_name') ?? ''), 100);
    const phone = sanitizeSingleLine(String(data.get('phone') ?? ''), 25);
    const email = sanitizeSingleLine(String(data.get('email') ?? ''), 120);
    const serviceKey = sanitizeSingleLine(String(data.get('service_interest') ?? ''), 40);
    const serviceLabel = serviceLabels[serviceKey] || 'Consulta General';
    const message = sanitizeMessage(String(data.get('message') ?? ''), 1000);

    if (!fullName || !phone || !email) return;

    const subject = `Consulta Web - ${serviceLabel} (${fullName})`;
    const bodyText = [
      `Nombre: ${fullName}`,
      `Teléfono / WhatsApp: ${phone}`,
      `Correo: ${email}`,
      `Servicio de interés: ${serviceLabel}`,
      '',
      'Detalle de la consulta:',
      message || '(Sin mensaje adicional)',
    ].join('\n');

    const mailtoUrl = `mailto:barrioscontadores@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;
    const whatsappFallbackUrl = `https://wa.me/50762272263?text=${encodeURIComponent(
      `Hola, soy ${fullName}. Me interesa: ${serviceLabel}. ${message ? 'Detalle: ' + message : ''} (Tel: ${phone}, Correo: ${email})`,
    )}`;

    if (mailtoLink) mailtoLink.href = mailtoUrl;
    if (waLink) waLink.href = whatsappFallbackUrl;
    statusBox?.classList.remove('hidden');
    statusBox?.classList.add('flex');

    form.reset();
    window.location.href = mailtoUrl;
  });
</script>
